# ============================================================================
#  Plateforme OPGI — configuration d'environnement (exemple)
#  Copier en `.env` et renseigner. JAMAIS de secret réel commité.
# ============================================================================

# --- Base de données --------------------------------------------------------
# URL utilisée par l'APPLICATION à l'exécution. DOIT pointer sur le rôle
# applicatif RESTREINT `opgi_app`, qui est SOUMIS à la Row-Level Security
# (filet d'isolation inter-organisme). Ne jamais faire tourner l'application
# avec le rôle propriétaire `opgi` (il contourne la RLS en tant que
# propriétaire des tables).
DATABASE_URL="postgresql://opgi_app:opgi_app_dev@127.0.0.1:5432/opgi_dev"

# URL DIRECTE utilisée UNIQUEMENT par les migrations et le seed (rôle
# propriétaire `opgi`). Les migrations créent les tables et les politiques RLS ;
# le seed insère les données de démonstration à travers plusieurs organismes,
# ce qui exige un rôle non soumis à la RLS.
DIRECT_DATABASE_URL="postgresql://opgi:opgi_dev@127.0.0.1:5432/opgi_dev"

# Base VIDE pour les tests d'isolation (vitest). Le nom doit finir par `_test`.
TEST_DATABASE_URL="postgresql://opgi_app:opgi_app_dev@127.0.0.1:5432/opgi_test"
TEST_DIRECT_DATABASE_URL="postgresql://opgi:opgi_dev@127.0.0.1:5432/opgi_test"

# --- Mode d'isolation (décision D2 — « les deux dès le départ ») ------------
# `shared`   : hébergement centralisé mutualisé. Plusieurs OPGI dans une base
#              partagée ; l'organisme actif provient de la SESSION serveur et
#              est appliqué par la RLS. Valeur par défaut.
# `dedicated`: installation chez l'OPGI. Une base par organisme ; `ORGANISATION_ID`
#              fixe l'unique organisme de l'instance. Schéma identique.
ISOLATION_MODE="shared"

# En mode `dedicated` uniquement : identifiant de l'unique organisme de l'instance.
# ORGANISATION_ID=""

# --- Secrets applicatifs (à générer par environnement) ----------------------
# Secret de signature des sessions. Générer : openssl rand -base64 48
SESSION_SECRET="change-me-in-production"

# --- Verrouillage anti‑bruteforce (brief §9) --------------------------------
# Nombre d'échecs de connexion consécutifs avant verrouillage, et durée du
# verrouillage en minutes. Valeurs par défaut : 5 tentatives, 15 minutes.
# LOGIN_MAX_ATTEMPTS="5"
# LOGIN_LOCK_MINUTES="15"
