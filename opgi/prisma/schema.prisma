// ============================================================================
//  Plateforme OPGI — schéma de données (socle multi‑organisme, Phase 1)
//
//  Invariant central : toute table métier porte `organisationId` NON NULL.
//  L'isolation est appliquée à DEUX niveaux (défense en profondeur) :
//    1. couche applicative — requêtes filtrées par l'organisme de la session ;
//    2. Row-Level Security PostgreSQL — filet si (1) oublie un filtre.
//  Voir prisma/migrations/*/rls.sql et docs/opgi/02-ISOLATION-MULTI-OPGI.md.
//
//  Le schéma est IDENTIQUE pour les deux modes d'exploitation (décision D2) :
//  hébergement centralisé (base partagée + RLS) et installation chez l'OPGI
//  (base dédiée). Seule la configuration d'isolation diffère, pas le schéma.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")        // rôle applicatif restreint (soumis RLS)
  directUrl = env("DIRECT_DATABASE_URL") // rôle propriétaire (migrations, seed)
}

// --- Référentiels d'énumération --------------------------------------------

enum ModuleOpgi {
  A // patrimoine & gestion locative
  B // projets, marchés & chantiers
  C // réclamations, maintenance & interventions
}

enum RoleOpgi {
  ADMIN_PLATEFORME    // technique, tous OPGI, AUCUN accès métier
  ADMIN_OPGI
  DIRECTION
  AGENT_LOCATIF
  AGENT_RECOUVREMENT
  CHEF_PROJET
  GESTIONNAIRE_MARCHES
  RESP_RECLAMATIONS
  TECHNICIEN
  PRESTATAIRE
  OCCUPANT
  AUDITEUR
}

enum TypeBien {
  LOGEMENT
  LOCAL_COMMERCIAL
  GARAGE
  AUTRE
}

enum EtatOccupation {
  OCCUPE
  VACANT
  INDISPONIBLE
}

enum TypeOccupant {
  PHYSIQUE // personne physique
  MORALE // personne morale (entreprise, administration)
}

enum StatutContrat {
  BROUILLON
  ACTIF
  SUSPENDU
  RESILIE
}

enum ModePaiement {
  ESPECES
  VIREMENT
  CHEQUE
  AUTRE
}

// Points de départ configurables — jamais une procédure réglementaire confirmée.
enum TypeActionRecouvrement {
  RELANCE
  MISE_EN_DEMEURE
  ECHEANCIER
  CONTENTIEUX
  AUTRE
}

// --- Module C — énumérations (points de départ configurables) ---------------
enum CategorieReclamation {
  PLOMBERIE
  ELECTRICITE
  MACONNERIE
  ASCENSEUR
  CHAUFFAGE
  PROPRETE
  AUTRE
}

enum UrgenceReclamation {
  FAIBLE
  NORMALE
  HAUTE
  CRITIQUE
}

enum StatutReclamation {
  NOUVELLE
  QUALIFIEE
  EN_COURS
  RESOLUE
  REJETEE
  DOUBLON
}

enum CanalReclamation {
  PORTAIL
  GUICHET
  TELEPHONE
  EMAIL
  COURRIER
  AUTRE
}

enum AffectationType {
  INTERNE
  EXTERNE
}

enum StatutOrdreTravail {
  OUVERT
  PLANIFIE
  EN_COURS
  CLOTURE
  ANNULE
}

// --- Module B — énumérations (points de départ configurables) ---------------
enum StatutProjet {
  EN_PREPARATION
  EN_COURS
  SUSPENDU
  CLOTURE
}

enum StatutMarche {
  EN_PREPARATION
  NOTIFIE
  EN_COURS
  RECEPTIONNE
  RESILIE
  CLOTURE
}

enum StatutSituation {
  DEPOSEE
  VERIFIEE
  VALIDEE
  REJETEE
}

enum TypeReception {
  PROVISOIRE
  DEFINITIVE
}

enum ResultatAudit {
  SUCCES
  ECHEC
}

// --- Organisme (tenant) -----------------------------------------------------

model Organisation {
  id        String       @id @default(cuid())
  // Code métier lisible, unique au niveau plateforme (ex. « OPGI-ALGER »).
  code      String       @unique
  nom       String
  actif     Boolean      @default(true)
  // Modules activés pour cet organisme (décision D5 — activation par config).
  modules   ModuleOpgi[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  utilisateurs Utilisateur[]
  biens        Bien[]
  occupants    Occupant[]
  contrats     Contrat[]
  appels       AppelLoyer[]
  paiements    Paiement[]
  imputations  Imputation[]
  actions      ActionRecouvrement[]
  reclamations Reclamation[]
  commentaires CommentaireReclamation[]
  ordres       OrdreTravail[]
  projets      Projet[]
  entreprises  Entreprise[]
  marches      Marche[]
  situations   SituationTravaux[]
  receptions   Reception[]
  auditLogs    AuditLog[]
  piecesJointes PieceJointe[]

  @@map("organisation")
}

// --- Utilisateur (toujours rattaché à un organisme) -------------------------
// Note : l'administrateur de plateforme (rôle technique sans accès métier) est
// géré hors de ce modèle dans les prochains incréments ; il n'apparaît jamais
// comme porteur de données métier d'un organisme.

model Utilisateur {
  id             String    @id @default(cuid())
  organisationId String
  email          String
  passwordHash   String?
  role           RoleOpgi
  // Périmètre organisationnel optionnel (service/zone) restreignant les droits.
  perimetre      String?
  actif          Boolean   @default(true)
  // Verrouillage anti‑bruteforce (brief §9) : compteur d'échecs et date de
  // déverrouillage. Seuil et durée configurables (voir src/lib/services.ts).
  echecsConnexion Int       @default(0)
  verrouilleJusqua DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  // Un même email peut exister dans deux OPGI distincts : unicité PAR organisme.
  @@unique([organisationId, email])
  @@index([organisationId])
  @@map("utilisateur")
}

// --- Bien (unité de patrimoine — Module A) ----------------------------------

model Bien {
  id             String         @id @default(cuid())
  organisationId String
  // Code métier du bien, unique PAR organisme.
  code           String
  type           TypeBien
  etatOccupation EtatOccupation @default(VACANT)
  adresse        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Archivage LOGIQUE (jamais de suppression physique — préserve l'historique).
  archiveLe DateTime?

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrats     Contrat[]
  reclamations Reclamation[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("bien")
}

// --- Occupant (personne physique ou morale — Module A) ----------------------

model Occupant {
  id             String       @id @default(cuid())
  organisationId String
  type           TypeOccupant @default(PHYSIQUE)
  // Nom de famille (physique) ou raison sociale (morale).
  nom            String
  prenom         String?
  telephone      String?
  email          String?
  archiveLe      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrats     Contrat[]
  reclamations Reclamation[]

  @@index([organisationId])
  @@map("occupant")
}

// --- Contrat de location (Module A) -----------------------------------------
// Aucun calcul de loyer/pénalité : `montantLoyerCentimes` est une saisie libre
// (devise DZD, granularité centime), paramétrable ultérieurement. Les statuts
// sont un point de départ configurable.

model Contrat {
  id             String        @id @default(cuid())
  organisationId String
  // Référence métier du contrat, unique PAR organisme.
  reference      String
  bienId         String
  occupantId     String
  statut         StatutContrat @default(BROUILLON)
  dateDebut      DateTime
  dateFin        DateTime?
  montantLoyerCentimes Int?
  archiveLe      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bien         Bien         @relation(fields: [bienId], references: [id], onDelete: Restrict)
  occupant     Occupant     @relation(fields: [occupantId], references: [id], onDelete: Restrict)
  appels       AppelLoyer[]
  paiements    Paiement[]
  actions      ActionRecouvrement[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([bienId])
  @@index([occupantId])
  @@map("contrat")
}

// --- Appel de loyer (Module A — locatif/financier) --------------------------
// Montant dû pour une période donnée. `montantCentimes` est une saisie libre
// (par défaut, le loyer du contrat au moment de la création) — aucun calcul de
// pénalité ou d'intérêt n'est effectué. Le solde se calcule par différence avec
// les imputations (jamais stocké pour éviter toute incohérence).

model AppelLoyer {
  id             String   @id @default(cuid())
  organisationId String
  contratId      String
  // Période libre (ex. « 2026-01 »), format paramétrable par l'organisme.
  periode        String
  libelle        String?
  montantCentimes Int
  dateEcheance   DateTime
  archiveLe      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrat      Contrat      @relation(fields: [contratId], references: [id], onDelete: Restrict)
  imputations  Imputation[]

  @@unique([organisationId, contratId, periode])
  @@index([organisationId])
  @@index([contratId])
  @@map("appel_loyer")
}

// --- Paiement (encaissement) ------------------------------------------------
// Encaissement constaté, RÉELLEMENT reçu. Jamais confondu avec un engagement :
// un paiement est rattaché à des appels par des imputations.

model Paiement {
  id             String       @id @default(cuid())
  organisationId String
  contratId      String
  montantCentimes Int
  datePaiement   DateTime
  mode           ModePaiement @default(VIREMENT)
  reference      String?
  note           String?
  archiveLe      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrat      Contrat      @relation(fields: [contratId], references: [id], onDelete: Restrict)
  imputations  Imputation[]

  @@index([organisationId])
  @@index([contratId])
  @@map("paiement")
}

// --- Imputation (affectation d'un paiement à un appel) ----------------------

model Imputation {
  id             String   @id @default(cuid())
  organisationId String
  paiementId     String
  appelId        String
  montantCentimes Int
  createdAt      DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  paiement     Paiement     @relation(fields: [paiementId], references: [id], onDelete: Cascade)
  appel        AppelLoyer   @relation(fields: [appelId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([paiementId])
  @@index([appelId])
  @@map("imputation")
}

// --- Action de recouvrement -------------------------------------------------
// Trace une action (statut via le type + responsable + date + pièce). Aucune
// automatisation de décision : simple journal des actions menées par l'agent.

model ActionRecouvrement {
  id             String                 @id @default(cuid())
  organisationId String
  contratId      String
  type           TypeActionRecouvrement
  date           DateTime
  montantConcerneCentimes Int?
  note           String?
  pieceReference String?
  responsableUtilisateurId String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  contrat      Contrat      @relation(fields: [contratId], references: [id], onDelete: Restrict)

  @@index([organisationId])
  @@index([contratId])
  @@map("action_recouvrement")
}

// ============================================================================
//  Module C — réclamations, maintenance & interventions
// ============================================================================

// --- Réclamation ------------------------------------------------------------
// Rattachée si possible à un bien et/ou un occupant. Le déclarant peut être un
// occupant du portail (declarantUtilisateurId) ou saisi par un agent au guichet.
// Les doublons sont REGROUPÉS (statut DOUBLON + doublonDeId), jamais supprimés.

model Reclamation {
  id             String               @id @default(cuid())
  organisationId String
  reference      String
  bienId         String?
  occupantId     String?
  // Déclarant via le portail (compte occupant) — sinon saisie libre ci-dessous.
  declarantUtilisateurId String?
  declarantNom     String?
  declarantContact String?
  categorie      CategorieReclamation
  urgence        UrgenceReclamation   @default(NORMALE)
  statut         StatutReclamation    @default(NOUVELLE)
  canal          CanalReclamation     @default(PORTAIL)
  description    String
  localisation   String?
  doublonDeId    String?
  archiveLe      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  bien         Bien?        @relation(fields: [bienId], references: [id], onDelete: SetNull)
  occupant     Occupant?    @relation(fields: [occupantId], references: [id], onDelete: SetNull)
  doublonDe    Reclamation? @relation("doublons", fields: [doublonDeId], references: [id], onDelete: SetNull)
  doublons     Reclamation[] @relation("doublons")
  commentaires CommentaireReclamation[]
  ordres       OrdreTravail[]
  pieces       PieceJointe[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([bienId])
  @@index([declarantUtilisateurId])
  @@map("reclamation")
}

// --- Pièce jointe d'une réclamation (accès MÉDIÉ) ---------------------------
// Le contenu est stocké hors base sous une clé OPAQUE préfixée par l'organisme
// (voir src/lib/storage) ; aucun accès direct public. La ligne est cloisonnée
// par RLS et le téléchargement passe par un contrôle d'autorisation + propriété
// (brief §7). Type MIME et taille contrôlés à l'upload.

model PieceJointe {
  id                  String   @id @default(cuid())
  organisationId      String
  reclamationId       String
  nomFichier          String
  typeMime            String
  tailleOctets        Int
  // Clé de stockage opaque « <organisationId>/<uuid> » (non devinable, non publique).
  cleStockage         String   @unique
  auteurUtilisateurId String?
  createdAt           DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reclamation  Reclamation  @relation(fields: [reclamationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([reclamationId])
  @@map("piece_jointe")
}

// --- Commentaire / échange sur une réclamation ------------------------------
// `interne` = visible des agents uniquement (jamais renvoyé au déclarant).

model CommentaireReclamation {
  id                 String   @id @default(cuid())
  organisationId     String
  reclamationId      String
  auteurUtilisateurId String?
  texte              String
  interne            Boolean  @default(false)
  createdAt          DateTime @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reclamation  Reclamation  @relation(fields: [reclamationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([reclamationId])
  @@map("commentaire_reclamation")
}

// --- Ordre de travail (intervention) ----------------------------------------
// Issu d'une réclamation ; affecté à un technicien interne OU un prestataire
// externe. Coûts estimé/constaté distincts. Aucun calcul automatique.

model OrdreTravail {
  id             String             @id @default(cuid())
  organisationId String
  reclamationId  String
  reference      String
  statut         StatutOrdreTravail @default(OUVERT)
  affectationType AffectationType?
  technicienUtilisateurId String?
  prestataireNom String?
  datePlanifiee  DateTime?
  coutEstimeCentimes   Int?
  coutConstateCentimes Int?
  compteRendu    String?
  archiveLe      DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  reclamation  Reclamation  @relation(fields: [reclamationId], references: [id], onDelete: Restrict)

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([reclamationId])
  @@index([technicienUtilisateurId])
  @@map("ordre_travail")
}

// ============================================================================
//  Module B — projets, marchés & chantiers
// ============================================================================

// --- Projet / opération -----------------------------------------------------
model Projet {
  id               String       @id @default(cuid())
  organisationId   String
  code             String
  intitule         String
  programme        String?
  sourceFinancement String?
  statut           StatutProjet @default(EN_PREPARATION)
  // Enveloppe prévisionnelle (saisie libre) — aucun calcul.
  montantInitialCentimes Int?
  dateDebut        DateTime?
  dateFinPrevue    DateTime?
  archiveLe        DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  marches      Marche[]

  @@unique([organisationId, code])
  @@index([organisationId])
  @@map("projet")
}

// --- Entreprise / prestataire de travaux ------------------------------------
model Entreprise {
  id             String    @id @default(cuid())
  organisationId String
  raisonSociale  String
  nif            String?
  rc             String?
  contact        String?
  archiveLe      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  marches      Marche[]

  @@index([organisationId])
  @@map("entreprise")
}

// --- Marché -----------------------------------------------------------------
// `montantCentimes` = montant ENGAGÉ (marché notifié). Le montant CONSTATÉ
// (avancement) provient des situations de travaux validées. La plateforme ne
// gère AUCUN paiement exécuté : engagement, constatation et paiement restent
// distincts (le paiement est hors périmètre, suivi par le système financier).
model Marche {
  id             String       @id @default(cuid())
  organisationId String
  reference      String
  projetId       String
  entrepriseId   String
  objet          String
  montantCentimes Int
  dateNotification DateTime?
  delaiJours     Int?
  statut         StatutMarche @default(EN_PREPARATION)
  archiveLe      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  projet       Projet       @relation(fields: [projetId], references: [id], onDelete: Restrict)
  entreprise   Entreprise   @relation(fields: [entrepriseId], references: [id], onDelete: Restrict)
  situations   SituationTravaux[]
  receptions   Reception[]

  @@unique([organisationId, reference])
  @@index([organisationId])
  @@index([projetId])
  @@index([entrepriseId])
  @@map("marche")
}

// --- Situation de travaux ---------------------------------------------------
// Dépôt → vérification → validation/rejet. `montantTravauxCentimes` = montant
// CONSTATÉ de la situation. `avancementPhysiquePct` = avancement physique (0-100).
model SituationTravaux {
  id             String          @id @default(cuid())
  organisationId String
  marcheId       String
  numero         Int
  periode        String?
  montantTravauxCentimes Int
  avancementPhysiquePct  Int?
  statut         StatutSituation @default(DEPOSEE)
  observations   String?
  dateDepot      DateTime
  dateDecision   DateTime?
  decideurUtilisateurId String?
  archiveLe      DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  marche       Marche       @relation(fields: [marcheId], references: [id], onDelete: Cascade)

  @@unique([marcheId, numero])
  @@index([organisationId])
  @@index([marcheId])
  @@map("situation_travaux")
}

// --- Réception (provisoire / définitive) ------------------------------------
model Reception {
  id             String        @id @default(cuid())
  organisationId String
  marcheId       String
  type           TypeReception
  date           DateTime
  avecReserves   Boolean       @default(false)
  observations   String?
  pvReference    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  marche       Marche       @relation(fields: [marcheId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([marcheId])
  @@map("reception")
}

// --- Journal d'audit (transverse) -------------------------------------------
// APPEND-ONLY : le rôle applicatif ne dispose que de SELECT + INSERT (UPDATE et
// DELETE révoqués — voir la migration rls_audit). Aucune donnée personnelle
// sensible dans `resume` (minimisation, brief §9). Isolé par organisme (RLS).
// Pas de updatedAt : une ligne d'audit est immuable.

model AuditLog {
  id             String        @id @default(cuid())
  organisationId String
  // Auteur de l'action (null pour une action système).
  utilisateurId  String?
  // Action normalisée, ex. « situation.validee », « paiement.create ».
  action         String
  objetType      String
  objetId        String?
  resultat       ResultatAudit @default(SUCCES)
  // Résumé court, SANS donnée personnelle (références/montants uniquement).
  resume         String?
  createdAt      DateTime      @default(now())

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId, createdAt])
  @@map("audit_log")
}
