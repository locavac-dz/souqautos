# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (dev SQLite database)
/prisma/dev.db
/prisma/dev.db-journal

# fichiers uploadés par les utilisateurs (photos d'annonces) — stockage local de dev,
# à migrer vers un stockage S3-compatible pour staging/prod (cf. docs/ARCHITECTURE.md §06)
/public/uploads/

# pièces d'identité (vérification, Lot 14) — jamais sous /public, servies uniquement
# via une route API authentifiée réservée au staff ; supprimées après décision de review
/private-uploads/
