// Lot 1 — Comptes & référentiel wilayas.
// PostgreSQL partout (développement, tests de bout en bout, production — Lot 109).
// PostGIS, prévu à l'origine (docs/ARCHITECTURE.md §06), n'est pas utilisé : la
// recherche géographique se fait par wilaya/commune, sans rayon.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PARTICULIER
  PROFESSIONNEL
  MODERATEUR
  SUPPORT
  ADMIN
  SUPER_ADMIN
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  phone           String?   @unique
  // Lot 132 — `null` pour un compte créé par « Continuer avec Google » qui n'a jamais défini de mot de passe : la
  // connexion par mot de passe lui est alors impossible (jamais un mot de passe « inutilisable » écrit à la place).
  passwordHash    String?
  role            Role      @default(PARTICULIER)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  identityVerifiedAt DateTime?
  locale          String    @default("fr")
  createdAt       DateTime  @default(now())
  // Suspension de compte (Lot 31) — manuelle (back-office) ou automatique
  // après seuil de signalements confirmés, même principe que Listing.status
  // SUSPENDUE (Lot 21) mais un simple horodatage suffit ici : aucun autre état
  // intermédiaire n'existe pour un compte (pas de file de modération).
  suspendedAt      DateTime?
  suspensionReason String?
  // Verrouillage de connexion après échecs répétés (Lot 102) — protège
  // uniquement la connexion (nouvelle tentative), jamais une session déjà
  // active, contrairement à suspendedAt ci-dessus. Auto-expire par simple
  // comparaison de date, aucun job requis (même principe que l'expiration
  // d'annonce). Remis à zéro à chaque connexion réussie.
  failedLoginAttempts Int       @default(0)
  lockedUntil          DateTime?
  // Suppression de compte à la demande du titulaire (Lot 51) — anonymisation,
  // jamais une suppression physique de la ligne : la plupart des relations
  // vers User sont en RESTRICT (cf. audit Lot 50), une vraie suppression
  // casserait l'historique de modération/avis/signalements. Distinct de
  // suspendedAt (Lot 31, décision de modération, réversible) : irréversible,
  // déclenché par le titulaire lui-même, jamais par un admin.
  deletedAt        DateTime?
  profile         Profile?
  listings        Listing[]
  favorites       Favorite[]
  auditLogs       AuditLog[]
  conversationsAsBuyer  Conversation[] @relation("BuyerConversations")
  conversationsAsSeller Conversation[] @relation("SellerConversations")
  prospectUpdates       ProspectFollowUp[]
  messages              Message[]
  blocksInitiated       Block[]        @relation("BlockerRelation")
  blocksReceived        Block[]        @relation("BlockedRelation")
  reports               Report[]       @relation("ReportAuthor")
  reportsReceived       Report[]       @relation("ReportedUser")
  reviewsReceived       Review[]       @relation("SellerReviews")
  reviewsWritten        Review[]       @relation("AuthorReviews")
  emailVerificationTokens EmailVerificationToken[]
  oauthAccounts           OAuthAccount[]
  passwordResetTokens     PasswordResetToken[]
  // Lot 133 — toute session ouverte AVANT cette date est refusée (les sessions sont des jetons signés sans état côté
  // serveur : sans cette date, on ne pourrait pas les révoquer). Posée à la réinitialisation du mot de passe : la
  // personne qui a perdu son mot de passe — ou dont le compte a été pris — déconnecte tous les appareils.
  sessionsValidAfter      DateTime?
  // Lot 138 — double authentification par application (TOTP, RFC 6238). Le secret n'est JAMAIS stocké en clair : chiffré
  // (AES-256-GCM, IV aléatoire, clé dérivée de ENCRYPTION_KEY) comme les pièces d'identité. `totpPendingSecretEnc` est le secret
  // affiché pendant l'activation, tant que la personne n'a pas prouvé qu'elle le lit dans son application : il ne sert à rien
  // avant confirmation. `totpLastStep` est le dernier pas de 30 s accepté : un code déjà utilisé (ou plus ancien) est refusé.
  totpSecretEnc           String?
  totpPendingSecretEnc    String?
  totpEnabledAt           DateTime?
  totpLastStep            Int?
  twoFactorRecoveryCodes  TwoFactorRecoveryCode[]
  emailChangeRequests     EmailChangeRequest[]
  phoneVerificationCodes  PhoneVerificationCode[]
  professionalAccount     ProfessionalAccount?
  proCollaborations       ProCollaborator[]
  blogArticles            BlogArticle[]
  createdPreviewLinks     ArticlePreviewLink[]
  identityVerificationRequests IdentityVerificationRequest[] @relation("IdentityRequester")
  identityReviewsPerformed     IdentityVerificationRequest[] @relation("IdentityReviewer")
  listingDraft                 ListingDraft?
  searchAlerts                 SearchAlert[]
  paymentOrders                PaymentOrder[] @relation("PaymentOrderAuthor")
  paymentOrdersReviewed        PaymentOrder[] @relation("PaymentOrderReviewer")
  proSubscriptionOrders         ProSubscriptionOrder[] @relation("ProSubscriptionOrderAuthor")
  proSubscriptionOrdersReviewed ProSubscriptionOrder[] @relation("ProSubscriptionOrderReviewer")
  ownerReviews                  OwnerReview[]
  // Lot 119 — le vendeur peut désactiver WhatsApp s'il ne souhaite pas être contacté
  // ainsi ; activé par défaut car c'est le canal dominant en Algérie.
  whatsappEnabled               Boolean @default(true)
  contactEvents                 ContactEvent[]
  pushSubscriptions             PushSubscription[]
  followedPros                  ProFollow[]
  // Lot 170 — offres de prix
  offersAsBuyer                 Offer[]  @relation("BuyerOffers")
  offersAsSeller                Offer[]  @relation("SellerOffers")
  // Lot 241 — centre de notifications in-app
  notifications                 UserNotification[]
  // Lot 243 — historique de connexion
  loginEvents                   LoginEvent[]
  // Lot 252 — messagerie de groupe
  groupsCreated    GroupConversation[] @relation("GroupCreator")
  groupMemberships GroupMember[]
  groupMessages    GroupMessage[]
}

model Profile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  wilayaId    Int?
  wilaya      Wilaya?  @relation(fields: [wilayaId], references: [id])
  bio         String?
  avatarUrl   String?
}

model Wilaya {
  id       Int       @id
  code     String    @unique
  // Lot 75 — page SEO /wilaya/{slug} (docs/ARCHITECTURE.md §2, ex. « /wilaya/alger »),
  // prévue depuis le cahier des charges mais jamais construite. Calculé une fois via
  // slugify(nomFr) (même fonction que Brand/Model/Equipment), pas géré par le seed
  // idempotent des wilayas elles-mêmes (référentiel figé, cf. Lot 25).
  slug     String    @unique
  nomFr    String
  nomAr    String
  profiles Profile[]
  listings Listing[]
  professionalAccounts ProfessionalAccount[]
  communes Commune[]
}

// Lot 87 — découpage administratif sous la wilaya (docs/ARCHITECTURE.md §5),
// référentiel figé comme Wilaya (Lot 25 : pas d'édition back-office, seed
// uniquement) : source officielle Ministère de l'Intérieur, 1541 communes,
// ids repris tels quels du jeu de données source (stables, jamais réattribués
// par le seed idempotent — même principe que les ids fixes de Wilaya).
model Commune {
  id       Int       @id
  wilayaId Int
  wilaya   Wilaya    @relation(fields: [wilayaId], references: [id])
  nomFr    String
  nomAr    String
  listings Listing[]

  @@index([wilayaId])
}

// --- Lot 2 — Catalogue véhicules & annonces ---
// Schéma volontairement plat (pas de generation/version/engine pour l'instant) :
// on ne modélise que ce qui est vérifiable (marque, modèle) ; les caractéristiques
// mécaniques sont déclarées par le vendeur directement sur l'annonce plutôt que
// rattachées à une fiche technique qui serait fabriquée sans source fiable.

model Brand {
  id     Int     @id @default(autoincrement())
  slug   String  @unique
  name   String
  // Lot 92 — nom arabe vérifié individuellement via Wikipédia arabe (même
  // discipline que Wilaya.nomAr/Commune.nomAr), `null` tant qu'une marque
  // n'a pas été vérifiée : référentiel volontairement partiel (marques
  // réellement utilisées par les annonces de démonstration), même principe
  // que Generation (Lot 88).
  nameAr String?
  models Model[]
  listings Listing[]
  roadTests RoadTest[]
  buyingGuides BuyingGuide[]
  pressReviews PressReview[]
}

model Model {
  id      Int     @id @default(autoincrement())
  brandId Int
  brand   Brand   @relation(fields: [brandId], references: [id])
  slug    String
  name    String
  // Lot 94 — nom arabe vérifié individuellement via Wikipédia arabe (+ une
  // seconde source pour Tiggo, faute d'article Wikipédia dédié), même
  // discipline que Brand.nameAr (Lot 92). `null` pour un modèle non encore
  // vérifié, et pour les codes alphanumériques ("208", "X5") qui restent en
  // usage réel écrits en latin même dans une phrase arabe — jamais couverts
  // par construction (aucune entrée nameAr n'existe pour eux dans le seed).
  nameAr String?
  // Lot 130 — catégories d'annonce où ce modèle est proposé (voiture, utilitaire, poids lourd, deux-roues).
  // Un TABLEAU et non une valeur : un Kangoo ou un Hilux s'annonce aussi bien comme voiture que comme
  // utilitaire. La catégorie d'une MARQUE se déduit de ses modèles (Renault : voitures + utilitaires + camions),
  // elle n'est jamais saisie à part. Par défaut VOITURE : c'était le seul usage avant ce lot.
  categories ListingCategory[] @default([VOITURE])
  listings Listing[]
  generations Generation[]
  roadTests RoadTest[]
  buyingGuides BuyingGuide[]
  pressReviews PressReview[]
  ownerReviews OwnerReview[]

  @@unique([brandId, slug])
}

// Lot 88 — profondeur de catalogue (docs/ARCHITECTURE.md §5). Contrairement à
// Wilaya/Commune (source officielle unique), il n'existe aucune source fiable
// unique pour les générations par modèle sur le marché algérien : référentiel
// VOLONTAIREMENT PARTIEL, vérifié modèle par modèle (jamais inventé) — voir
// prisma/generation-data.ts pour le détail des sources et la couverture
// (24 modèles réellement utilisés par les annonces de démonstration, pas les
// 108 du catalogue). Comme Wilaya/Commune : référentiel figé, seed uniquement,
// pas d'édition back-office dans ce lot.
model Generation {
  id        Int      @id @default(autoincrement())
  modelId   Int
  model     Model    @relation(fields: [modelId], references: [id])
  name      String
  yearStart Int
  // null = génération toujours produite/vendue au moment du seed — jamais une
  // date de fin inventée pour une génération encore en production.
  yearEnd   Int?
  listings  Listing[]
  roadTests RoadTest[]
  buyingGuides BuyingGuide[]

  @@index([modelId])
  @@unique([modelId, name])
}

// Lot 72 — équipements du véhicule (docs/ARCHITECTURE.md §14 : « équipements »
// fait partie des critères de comparabilité pour le badge « Bon Prix », au même
// titre qu'année/km/wilaya). Référentiel réel (options effectivement courantes
// sur un véhicule d'occasion), jamais une fiche technique fabriquée — même
// discipline que Brand/Model (cf. commentaire de tête, ligne 90).
enum EquipmentCategory {
  CONFORT
  SECURITE
  MULTIMEDIA
  EXTERIEUR
  ACCESSOIRE
}

model Equipment {
  id       Int                @id @default(autoincrement())
  slug     String             @unique
  nameFr   String
  nameAr   String
  category EquipmentCategory
  listings ListingEquipment[]
}

model ListingEquipment {
  listingId   String
  listing     Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  equipmentId Int
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  @@id([listingId, equipmentId])
  @@index([equipmentId])
}

enum ListingCategory {
  VOITURE
  UTILITAIRE
  POIDS_LOURD
  DEUX_ROUES
  AUTRE
  EQUIPEMENT
}

enum FuelType {
  ESSENCE
  DIESEL
  GPL
  HYBRIDE
  ELECTRIQUE
}

enum Gearbox {
  MANUELLE
  AUTOMATIQUE
}

enum Transmission {
  QUATRE_X_DEUX
  QUATRE_X_QUATRE
}

enum ListingCondition {
  NEUF
  OCCASION
}

enum ListingStatus {
  BROUILLON
  EN_ATTENTE
  PUBLIEE
  SUSPENDUE
  REFUSEE
  VENDUE
  EXPIREE
}

enum ListingFormula {
  STANDARD
  PREMIUM
  PREMIUM_PLUS
}

enum BodyType {
  BERLINE
  SUV
  BREAK
  CITADINE
  COUPE
  CABRIOLET
  MONOSPACE
  PICKUP
  FOURGON
}

model Listing {
  id           String           @id @default(cuid())
  sellerId     String
  seller       User             @relation(fields: [sellerId], references: [id])
  category     ListingCategory
  brandId      Int?
  brand        Brand?           @relation(fields: [brandId], references: [id])
  modelId      Int?
  model        Model?           @relation(fields: [modelId], references: [id])
  // Lot 88 — génération du modèle (docs/ARCHITECTURE.md §5), nullable comme
  // commune (Lot 87) : couverture volontairement partielle du catalogue,
  // jamais un choix forcé quand le modèle n'a pas encore de génération référencée.
  generationId Int?
  generation   Generation?      @relation(fields: [generationId], references: [id])
  // Repli texte libre quand le véhicule n'est pas dans le catalogue (ex: motos,
  // marques non encore référencées) — jamais de fiche catalogue fabriquée pour compenser.
  brandFreeText String?
  modelFreeText String?
  title        String
  description  String
  price        Int // DZD
  year         Int
  mileage      Int?
  fuelType     FuelType?
  gearbox      Gearbox?
  transmission Transmission?
  color        String?
  doors        Int?
  seats        Int?
  powerHp      Int?
  condition    ListingCondition
  firstHand    Boolean          @default(false)
  accidented   Boolean          @default(false)
  // Lot 173 — informations administratives optionnelles (très demandées en Algérie
  // avant toute visite) : date d'expiration du contrôle technique et de l'assurance.
  controltechniqueExpiry DateTime?
  assuranceExpiry        DateTime?
  // Lot 177 — puissance fiscale (CV fiscaux), distincte de la puissance moteur en ch.
  // Utilisée en Algérie pour le calcul des primes d'assurance.
  fiscalPower            Int?
  // Lot 178 — type de carrosserie et prix négociable.
  bodyType               BodyType?
  negotiable             Boolean          @default(false)
  wilayaId     Int
  wilaya       Wilaya           @relation(fields: [wilayaId], references: [id])
  // Lot 87 — précision géographique optionnelle sous la wilaya (docs/ARCHITECTURE.md
  // §5, jamais construite depuis le Lot 2). Nullable : les annonces existantes et
  // toute future annonce sans commune choisie restent valides, la wilaya seule
  // reste le niveau géographique obligatoire.
  communeId    Int?
  commune      Commune?         @relation(fields: [communeId], references: [id])
  formula      ListingFormula   @default(STANDARD)
  status       ListingStatus    @default(BROUILLON)
  // Motif affiché au vendeur quand le statut est REFUSEE ou SUSPENDUE (§39).
  moderationNote String?
  views        Int              @default(0)
  photos       ListingPhoto[]
  favoritedBy  Favorite[]
  conversations Conversation[]
  reports      Report[]
  priceHistory ListingPriceHistory[]
  renewals     ListingRenewal[]
  viewDays     ListingViewDay[]
  searchAlertNotifications SearchAlertNotification[]
  paymentOrders PaymentOrder[]
  offers        Offer[]
  // Lot 72 — comble l'écart documenté depuis le Lot 4/45 (docs/ARCHITECTURE.md
  // §14 : la comparabilité pour le badge « Bon Prix » doit tenir compte des
  // équipements, pas seulement année/km/wilaya).
  equipments   ListingEquipment[]
  createdAt    DateTime         @default(now())
  publishedAt  DateTime?
  // Fixée à publishedAt + LISTING_VALIDITY_DAYS lors de la publication ou du
  // renouvellement (cf. src/lib/listing-lifecycle.ts) — permet l'expiration
  // automatique (§ ancien Lot 2) sans planificateur dédié, cf. sweepExpiredListings().
  expiresAt    DateTime?
  // Lot 48 — rappel email avant expiration, balayé paresseusement comme
  // l'expiration elle-même (aucun scheduler dans cette application). Remis à
  // null à chaque renouvellement (nouveau cycle d'expiration, cf. route renew).
  expiryReminderSentAt DateTime?
  // Lot 82 — renouvellement automatique (§4-B, "outils avancés" Pro/Premium).
  // Préférence par annonce, jamais activée d'office même pour un compte
  // éligible — l'éligibilité réelle du vendeur (palier effectif au moment du
  // balayage, pas au moment de l'activation) est revérifiée par
  // sweepAutoRenewals() à chaque cycle, jamais mise en cache ici.
  autoRenew    Boolean          @default(false)
  // Lot 84 — signal anti-fraude "spam" (§16 : "répétition de contenu ...
  // pour un même vendeur") : empreinte du titre+description normalisés,
  // recalculée à chaque création/édition. Permet de repérer un texte
  // strictement identique republié par un AUTRE vendeur (copier-coller
  // classique d'une annonce-appât sous plusieurs faux comptes) — même
  // principe que ListingPhoto.sha256 (Lot 77), jamais une comparaison floue.
  contentHash  String           @default("")
  // Lot 246 — score de risque persistant (V3, §16) : calculé à la soumission
  // via after() et rafraîchi à chaque édition — évite un recalcul complet à
  // chaque chargement de la file de modération. Pondéré sur les 5 signaux
  // (duplicatePhoto 40, duplicateContent 35, lowPrice/vehicleInconsistency 20,
  // sellerRejectionHistory 15 — plafonné à 100). Permet de trier la file par
  // risque décroissant plutôt que par date d'arrivée.
  fraudScore     Int       @default(0)
  fraudCheckedAt DateTime?
  // Analyse Claude API du texte de l'annonce (V3 « Règles + IA »).
  // null si ANTHROPIC_API_KEY absent ou aucun signal détecté.
  // Jamais affiché au vendeur — aide à la décision du modérateur uniquement.
  aiSuspicion    String?
  aiCheckedAt    DateTime?
  // Estimation de prix par IA (Lot 248) — activée uniquement si < 3 comparables
  // DB. Complète price-estimation.ts qui retourne null faute de données.
  priceAiLow     Int?
  priceAiHigh    Int?
  priceAiAt      DateTime?

  @@index([status, category, wilayaId])
  // Lot 137 — mesurés sur 20 000 annonces (EXPLAIN ANALYZE) : la recherche « plus récentes » lisait toute la table pour
  // n'en garder que 20 (6,7 ms → 0,08 ms avec cet index, et l'écart croît avec le nombre d'annonces), et les annonces d'un
  // modèle (page du modèle, comparables de prix) aussi (3,4 ms → 0,06 ms pour un modèle rare).
  @@index([status, createdAt(sort: Desc)])
  @@index([status, publishedAt(sort: Desc)])
  @@index([status, brandId, modelId])

  @@index([sellerId])
  @@index([status, expiresAt])
  @@index([contentHash])
  @@index([communeId])
  @@index([generationId])
  // Lot 246 — tri de la file de modération par risque décroissant.
  @@index([status, fraudScore(sort: Desc)])
  contactEvents    ContactEvent[]
  callbackRequests CallbackRequest[]
}

// Lot 45 — historique des prix (écart documenté depuis le Lot 4). Une entrée
// à la création (prix initial) et une à chaque changement réel de prix via
// PATCH .../update-price (Lot 23) — jamais sur une édition de contenu, qui ne
// touche jamais au prix (§ Lot 30). Les annonces créées par import de masse
// (Lot 41, prisma.listing.createMany) n'ont pas d'entrée initiale — limitation
// assumée pour ne pas remplacer le createMany par des créations une par une
// sur un import pouvant atteindre 500 lignes ; leur historique démarre au
// premier changement de prix réel, comme toute annonce.
model ListingPriceHistory {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price      Int
  recordedAt DateTime @default(now())

  @@index([listingId])
}

// Lot 49 — historique des renouvellements (second volet de l'écart du Lot 22,
// le premier — rappel avant expiration — a été traité au Lot 48). Une entrée
// par renouvellement réel (jamais à la publication initiale, qui n'est pas un
// renouvellement) ; `expiresAt` capture la nouvelle date résultant de ce
// renouvellement précis, pour ne pas dépendre de `Listing.expiresAt` qui
// n'est plus qu'un stock de la dernière valeur.
model ListingRenewal {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  renewedAt DateTime @default(now())
  expiresAt DateTime

  @@index([listingId])
}

// Lot 44 — brouillon persistant de l'assistant de publication, indépendant du
// modèle Listing (dont les champs obligatoires — title/price/year/etc. — ne
// sont tous réunis qu'à l'avant-dernière étape). Un JSON libre (le même
// WizardData sérialisé côté client), jamais interprété ni validé côté serveur
// au-delà de sa taille : il n'est restitué qu'au même assistant, qui refait
// sa propre validation étape par étape avant toute publication réelle. Un
// seul brouillon actif par utilisateur (userId unique) — démarrer un nouveau
// brouillon écrase simplement l'ancien, pas d'historique à conserver. Les
// photos (objets File) ne sont volontairement jamais incluses : limitation
// assumée, documentée à l'utilisateur (cf. Décisions/notes du Lot 44).
model ListingDraft {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// --- Lot 5 — Favoris ---
// Uniquement les véhicules favoris pour l'instant : « vendeur favori » suppose une
// page vitrine publique (pas encore construite) et « recherche favorite » recoupe
// les alertes (§27), qui nécessitent une infra de notification non encore en place.
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

// --- Lot 7 — Back-office & modération ---
// Lot 47 — seuils de signalement configurables depuis le back-office (écart
// documenté depuis le Lot 21). Ligne singleton (id fixe) plutôt qu'une table
// clé/valeur générique — les deux seuls réglages qui existent aujourd'hui
// sont ces deux seuils, pas besoin de généraliser tant qu'aucun autre réglage
// n'est prévu. Valeurs par défaut = comportement historique inchangé (3/3).
model ModerationSettings {
  id                          String   @id @default("singleton")
  autoSuspendListingThreshold Int      @default(3)
  autoSuspendUserThreshold    Int      @default(3)
  updatedAt                   DateTime @updatedAt
}

// Lot 66 — premier mode de paiement réel (virement bancaire manuel, décidé
// avec le porteur de projet en attendant un accès SATIM/CIB-Edahabia, cf.
// docs/ARCHITECTURE.md §11). Ligne singleton comme ModerationSettings : les
// coordonnées bancaires et les prix restent nuls tant qu'aucun admin ne les a
// renseignés — jamais une valeur bancaire inventée sur un document consulté
// par de vrais acheteurs. Les prix par défaut (non nuls) sont un point de
// départ fonctionnel modifiable immédiatement en back-office, pas un prix
// décidé pour l'EURL.
model PaymentSettings {
  id                  String   @id @default("singleton")
  bankName            String?
  bankRib             String?
  bankAccountHolder   String?
  premiumPriceDzd     Int      @default(1000)
  premiumPlusPriceDzd Int      @default(2000)
  updatedAt           DateTime @updatedAt
}

// ANNULEE (Lot 264) : paiement en ligne échoué, annulé ou expiré côté prestataire — ni confirmé, ni
// refusé par un humain. Libère la place « une seule commande EN_ATTENTE » pour une nouvelle tentative.
enum PaymentOrderStatus {
  EN_ATTENTE
  CONFIRMEE
  REJETEE
  ANNULEE
}

// Lot 264 — qui encaisse. VIREMENT : rapprochement humain (Lot 66). CHARGILY : Chargily Pay
// (CIB / Edahabia), confirmé par webhook signé ou relecture du statut chez le prestataire —
// jamais sur la seule URL de retour du navigateur, que l'acheteur peut forger ou ne jamais ouvrir.
enum PaymentProvider {
  VIREMENT
  CHARGILY
}

// Une commande = une demande de passage en formule payante (PREMIUM ou
// PREMIUM_PLUS) pour une annonce précise. `reference` est le libellé de
// virement fourni par le vendeur pour permettre à l'admin de rapprocher le
// virement reçu sur le relevé bancaire — jamais vérifié automatiquement
// (aucune API bancaire, confirmation humaine uniquement, cf. même principe
// que la vérification d'identité, Lot 14). Pour CHARGILY, `reference` est
// l'identifiant de la commande elle-même et `providerCheckoutId` l'identifiant
// du checkout Chargily (unique : c'est par lui qu'un webhook retrouve la commande).
model PaymentOrder {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation("PaymentOrderAuthor", fields: [userId], references: [id], onDelete: Cascade)
  listingId          String
  listing            Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  formula            ListingFormula
  amountDzd          Int
  reference          String
  provider           PaymentProvider    @default(VIREMENT)
  providerCheckoutId String?            @unique
  paidAt             DateTime?
  status             PaymentOrderStatus @default(EN_ATTENTE)
  reviewedById       String?
  reviewedBy         User?              @relation("PaymentOrderReviewer", fields: [reviewedById], references: [id])
  reviewNote         String?
  createdAt          DateTime           @default(now())
  reviewedAt         DateTime?

  @@index([status])
  @@index([userId])
  @@index([listingId])
  // Un seul virement EN_ATTENTE par annonce est déjà vérifié en application
  // (route upgrade-formula/route.ts) — même piège TOCTOU que
  // IdentityVerificationRequest (double-clic/retry créant deux demandes) ;
  // même correctif : index unique filtré ajouté en SQL brut dans la
  // migration correspondante, cf. audit sécurité Lot 69.
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  action     String // ex: "listing.approve", "listing.reject", "listing.suspend", "user.role_change"
  targetType String // "Listing" | "User"
  targetId   String
  details    String? // JSON libre (motif, ancien/nouveau statut, etc.)
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([adminId])
}

// --- Lot 8 — Messagerie interne (§19) ---
// Une conversation par (annonce, acheteur) — le vendeur y répond ; pas de fil
// générique acheteur/vendeur indépendant d'une annonce, pour rester simple et
// toujours contextualisé au véhicule concerné.
model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]
  // Suppression = masquage par utilisateur, jamais une destruction des messages
  // de l'autre partie (cf. Lot 26) — un nouveau message efface les deux
  // horodatages, ce qui fait réapparaître la conversation pour tout le monde.
  hiddenByBuyerAt  DateTime?
  hiddenBySellerAt DateTime?
  prospectFollowUp ProspectFollowUp?

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  // Pièce jointe image optionnelle (Lot 39) — un message peut contenir du
  // texte, une image, ou les deux (jamais ni l'un ni l'autre : cf.
  // checkMessageHasContent). Effacée (mise à null) comme le contenu au
  // moment d'une suppression (Lot 38) ; le fichier reste sur disque, comme
  // les photos d'annonce supprimées (Lot 36).
  attachmentUrl  String?
  // Lot 251 — message vocal enregistré depuis le navigateur (WebM/OGG/MP4).
  // Champ distinct de attachmentUrl pour différencier audio et image à l'affichage.
  audioUrl       String?
  readAt         DateTime?
  createdAt      DateTime     @default(now())
  // Suppression « pour tout le monde » (Lot 38) — seul l'expéditeur peut
  // supprimer son propre message. Le contenu original est réellement effacé
  // (pas juste masqué), remplacé par une chaîne vide ; deletedAt pilote
  // l'affichage du tombstone « Message supprimé » côté UI.
  deletedAt      DateTime?

  @@index([conversationId])
  // Comptage des messages non lus (badge du header, boîte de réception) —
  // filtré sur conversationId+readAt à chaque chargement de page, cf. audit
  // sécurité/perf.
  @@index([conversationId, readAt])
  @@index([senderId, readAt])
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// --- Lot 9 — Signalement d'annonce (§25) ---
// Un signalement par (annonce, auteur) — évite le spam d'un même utilisateur sur
// la même annonce sans empêcher plusieurs utilisateurs différents de signaler.
// Signalement d'utilisateur (hors annonce) volontairement hors périmètre : le
// cahier d'architecture (§41) le prévoit avec un user_id_signale nullable, mais
// rien ne le consomme encore (pas de vitrine profil public) — à étendre le jour
// où ce besoin devient réel plutôt que d'ajouter une colonne inutilisée aujourd'hui.
enum ReportReason {
  PRIX_SUSPECT
  FRAUDE_SUSPECTEE
  VEHICULE_VOLE
  DOUBLON
  CONTENU_INAPPROPRIE
  // --- Lot 19 — motifs propres au signalement d'utilisateur ---
  COMPORTEMENT_FRAUDULEUX
  MESSAGES_ABUSIFS
  USURPATION_IDENTITE
  AUTRE
}

enum ReportStatus {
  OUVERT
  TRAITE
  REJETE
}

// Cible soit une annonce (listingId), soit un utilisateur (reportedUserId) —
// jamais les deux, jamais aucun des deux ; invariant vérifié en application
// (pas de CHECK constraint portable ajouté), cf. src/lib/reports.ts. Les deux
// contraintes d'unicité ci-dessous cohabitent sans conflit : SQLite (comme
// Postgres) ne considère jamais deux NULL comme égaux dans un index unique.
model Report {
  id             String       @id @default(cuid())
  listingId      String?
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reportedUserId String?
  reportedUser   User?        @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  // Lot 116 — un signalement peut aussi viser un avis de propriétaire publié.
  ownerReviewId  String?
  ownerReview    OwnerReview? @relation(fields: [ownerReviewId], references: [id], onDelete: Cascade)
  authorId       String
  author         User         @relation("ReportAuthor", fields: [authorId], references: [id])
  reason         ReportReason
  comment        String?
  status         ReportStatus @default(OUVERT)
  // Note interne du modérateur qui traite/rejette (jamais visible par l'auteur du signalement).
  resolutionNote String?
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?

  @@unique([listingId, authorId])
  @@unique([reportedUserId, authorId])
  @@unique([ownerReviewId, authorId])
  @@index([status])
}

// --- Lot 10 — Avis vendeur (§26/§42) ; étendu au Lot 19 pour cibler aussi un
// compte professionnel (professionalAccountId) maintenant que la vitrine pro
// existe (Lot 13) — un avis cible soit un vendeur individuel, soit une
// entreprise, jamais les deux (même traitement NULL-safe que Report
// ci-dessus). Un avis professionnel reste éligible sur la même preuve
// d'interaction qu'un avis individuel (conversation sur une annonce du
// propriétaire du compte) : toutes les annonces d'une entreprise restent
// rattachées à l'utilisateur propriétaire, pas à un collaborateur distinct.
// Lot 167 — pré-modération des avis entre particuliers.
// PENDING : attend validation admin. APPROVED : publié. REJECTED : refusé (non visible).
// Les avis existants (avant ce lot) ont été migrés vers APPROVED (cf. migration).
// Auto-approbation : si l'auteur a déjà un avis APPROVED, le nouvel avis est directement APPROVED.
enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                     String               @id @default(cuid())
  sellerId               String?
  seller                 User?                @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  professionalAccountId  String?
  professionalAccount    ProfessionalAccount? @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  authorId               String
  author                 User                 @relation("AuthorReviews", fields: [authorId], references: [id])
  rating                 Int
  comment                String?
  createdAt              DateTime             @default(now())
  // Réponse du vendeur/de l'entreprise évaluée (Lot 27) — un seul propriétaire
  // possible par avis (le vendeur lui-même, ou le propriétaire/gestionnaire du
  // compte professionnel), jamais l'auteur de l'avis.
  reply                  String?
  repliedAt              DateTime?
  status                 ReviewStatus         @default(PENDING)

  @@unique([sellerId, authorId])
  @@unique([professionalAccountId, authorId])
  @@index([sellerId])
  @@index([professionalAccountId])
  @@index([status])
}

// --- Lot 11 — Vérification email/téléphone (prérequis honnête du score de
// confiance §26 : emailVerifiedAt/phoneVerifiedAt existent sur User depuis le
// Lot 1 mais rien ne les renseignait jusqu'ici) ---
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Lot 33 — Édition d'email avec confirmation par lien ---
// Modèle distinct d'EmailVerificationToken : celui-ci confirme la POSSESSION
// d'une NOUVELLE adresse avant de l'activer, jamais une simple revérification
// de l'adresse actuelle. Le lien part vers la nouvelle adresse, jamais
// l'ancienne — seule la preuve de réception à la nouvelle adresse compte.
model EmailChangeRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail  String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PhoneVerificationCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// --- Lot 13 — Comptes professionnels, fondations (§9/§26 du cahier
// d'architecture) ---
// Un seul palier fonctionnel (pas d'abonnement Starter/Business/Pro/Premium
// payant, cf. §11 §104-110) : le paiement reste bloqué en attente
// d'identifiants réels, même arbitrage que les formules Premium/Premium+ des
// annonces (Lot 2). `badgeVerifie` reste un simple bouton admin (aucun KYC
// registre de commerce automatisé construit) — un vrai signal, pas fabriqué,
// simplement vérifié manuellement par un humain plutôt qu'une machine.
model ProfessionalAccount {
  id            String            @id @default(cuid())
  userId        String            @unique
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nomCommercial String
  presentation  String?
  horaires      String?
  // Lot 155 — coordonnées et catégorie d'activité
  phone         String?
  website       String?
  categoryPro   ProCategory?
  // Lot 156 — horaires structurés par jour (JSON sérialisé, 7 jours × {open, debut, fin})
  horairesSemaine String?
  // Lot 157 — nombre de visites de la vitrine publique (toutes sources confondues, non filtré bots)
  vitrineViews    Int     @default(0)
  logoUrl       String?
  bannerUrl     String?
  wilayaId      Int?
  wilaya        Wilaya?           @relation(fields: [wilayaId], references: [id])
  badgeVerifie  Boolean           @default(false)
  createdAt     DateTime          @default(now())
  collaborators    ProCollaborator[]
  reviews          Review[]
  subscription     ProSubscription?
  subscriptionOrders ProSubscriptionOrder[]
  callbackRequests CallbackRequest[]
  followers        ProFollow[]

  @@index([wilayaId])
  @@index([categoryPro])
}

enum ProCategory {
  CONCESSIONNAIRE_NEUF
  OCCASION
  GARAGE
  IMPORTATEUR
  PIECES_DETACHEES
}

model ProCollaborator {
  id                    String              @id @default(cuid())
  professionalAccountId String
  professionalAccount   ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Permissions plus fines (Lot 42) — remplace le rôle binaire
  // GESTIONNAIRE/LECTURE_SEULE d'origine (Lot 13) par un JSON libre
  // (encodé en texte, cf. src/lib/pro-permissions.ts) : chaque capacité
  // (gestion des annonces, réponse aux avis) devient indépendamment
  // accordable plutôt qu'un seul bloc tout-ou-rien.
  permissions           String              @default("{\"gererAnnonces\":false,\"repondreAvis\":false}")
  createdAt             DateTime            @default(now())

  @@unique([professionalAccountId, userId])
  @@index([userId])
}

// --- Lot 79 — Abonnements professionnels (§4-B / §11 du cahier
// d'architecture, paliers Starter/Business/Pro/Premium) ---
// Écart documenté depuis le Lot 13 ("un seul palier fonctionnel, pas
// d'abonnement payant, le paiement reste bloqué en attente d'identifiants
// réels") — devenu obsolète depuis que le virement bancaire manuel a été
// adopté comme méthode de paiement réelle pour les formules d'annonce
// (Lot 66). Même mécanisme reproduit ici pour les comptes pro : jamais de
// fausse intégration CIB/Edahabia, un virement + rapprochement humain.
enum ProSubscriptionTier {
  STARTER
  BUSINESS
  PRO
  PREMIUM
}

// Une ligne par compte pro, créée paresseusement au premier besoin (comme
// PaymentSettings) plutôt qu'à l'inscription — un compte pro sans ligne est
// implicitement STARTER (palier gratuit par défaut, cf. src/lib/pro-subscription.ts).
model ProSubscription {
  id                    String              @id @default(cuid())
  professionalAccountId String              @unique
  professionalAccount   ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  tier                  ProSubscriptionTier @default(STARTER)
  // `null` pour STARTER (gratuit, jamais expiré) ; fixée à la date
  // d'approbation + durée de validité pour un palier payant (même principe
  // que Listing.expiresAt pour les formules d'annonce, Lot 66).
  expiresAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
}

model ProSubscriptionOrder {
  id                    String              @id @default(cuid())
  professionalAccountId String
  professionalAccount   ProfessionalAccount @relation(fields: [professionalAccountId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation("ProSubscriptionOrderAuthor", fields: [userId], references: [id], onDelete: Cascade)
  tier                  ProSubscriptionTier
  amountDzd             Int
  reference             String
  provider              PaymentProvider     @default(VIREMENT)
  providerCheckoutId    String?             @unique
  paidAt                DateTime?
  status                PaymentOrderStatus  @default(EN_ATTENTE)
  reviewedById          String?
  reviewedBy            User?               @relation("ProSubscriptionOrderReviewer", fields: [reviewedById], references: [id])
  reviewNote            String?
  createdAt             DateTime            @default(now())
  reviewedAt            DateTime?

  @@index([status])
  @@index([professionalAccountId])
  // Un seul virement EN_ATTENTE par compte pro — même piège TOCTOU que
  // PaymentOrder (Lot 69), corrigé de la même façon dès ce lot (index unique
  // filtré ajouté en SQL brut dans la migration, jamais laissé pour plus tard).
}

// Lot 83 — quotas/prix d'abonnement pro rendus configurables en back-office,
// jusqu'ici codés en dur dans src/lib/pro-subscription.ts (Lot 79, choix
// assumé « valeur fonctionnelle d'abord, éditable plus tard » — même
// trajectoire que AUTO_SUSPEND_*_THRESHOLD, Lot 21→47). Ligne singleton
// comme PaymentSettings/ModerationSettings. PREMIUM reste toujours illimité
// (jamais un champ de quota pour lui — un nombre, aussi grand soit-il, ne
// représenterait pas honnêtement "illimité").
model ProSubscriptionSettings {
  id               String   @id @default("singleton")
  starterQuota     Int      @default(5)
  businessQuota    Int      @default(20)
  proQuota         Int      @default(60)
  businessPriceDzd Int      @default(3000)
  proPriceDzd      Int      @default(6000)
  premiumPriceDzd  Int      @default(12000)
  updatedAt        DateTime @updatedAt
}

// --- Lot 14 — Vérification d'identité (§26, KYC léger manuel) ---
// Aucune API KYC tierce réelle (Onfido/Jumio/Veriff) intégrée — même blocage
// que le paiement (identifiants réels non disponibles). Traitement honnête :
// un humain (modérateur/admin) examine la pièce uploadée et approuve/refuse,
// jamais une vérification automatisée fabriquée. Le fichier uploadé est
// supprimé du disque dès la décision prise (approuvée ou refusée) — on ne
// conserve indéfiniment aucune copie de pièce d'identité une fois la revue
// terminée, seule la décision (statut + note) reste en base.
enum IdentityVerificationStatus {
  EN_ATTENTE
  APPROUVEE
  REFUSEE
}

model IdentityVerificationRequest {
  id           String                     @id @default(cuid())
  userId       String
  user         User                       @relation("IdentityRequester", fields: [userId], references: [id], onDelete: Cascade)
  documentPath String?
  documentMime String?
  status       IdentityVerificationStatus @default(EN_ATTENTE)
  reviewedById String?
  reviewedBy   User?                      @relation("IdentityReviewer", fields: [reviewedById], references: [id])
  reviewNote   String?
  createdAt    DateTime                   @default(now())
  reviewedAt   DateTime?

  @@index([status])
  @@index([userId])
  // Un seul dossier EN_ATTENTE par utilisateur est déjà vérifié en
  // application (route request/route.ts) — un index unique filtré au niveau
  // SQLite (WHERE status = 'EN_ATTENTE') ferme la course concurrente
  // (double-clic/retry réseau) que Prisma ne modélise pas nativement ; ajouté
  // en SQL brut dans la migration correspondante, cf. audit sécurité.
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  path      String
  position  Int
  // Lot 77 — signal anti-fraude (docs/ARCHITECTURE.md §16) : empreinte des
  // octets réellement stockés (après le pipeline sharp déterministe), jamais
  // du fichier brut envoyé par le client. Permet de repérer une photo
  // strictement identique réutilisée par un AUTRE vendeur (indice de vol de
  // photo/annonce copiée), sans prétendre détecter un recadrage ou une
  // recompression différente — ce n'est pas un hash perceptuel.
  sha256    String   @default("")
  // Lot 125 — crédit d'une photo publiée sous licence libre (annonces de démonstration, photos de
  // Wikimedia Commons). Les licences CC BY / CC BY-SA imposent de nommer l'auteur, d'indiquer la
  // licence et de renvoyer à la source : ces quatre champs sont affichés sous la photo. Tous vides
  // pour une photo envoyée par un vendeur (elle lui appartient).
  creditAuthor     String?
  creditLicense    String?
  creditLicenseUrl String?
  creditSourceUrl  String?
  // Lot 86 — analyse qualité photo (docs/ARCHITECTURE.md §36) : liste JSON de
  // PhotoQualityFlag (cf. src/lib/photo-quality.ts), calculée une seule fois à
  // l'upload sur les octets déjà traités par sharp. Purement indicative pour
  // le vendeur (nudge sur /compte/mes-annonces) — jamais un signal de fraude,
  // jamais visible des acheteurs ni des modérateurs.
  qualityFlags String @default("[]")
  // Lot 247 — analyse Claude Vision (V3, §16 « analyse photo ») : JSON sérialisé
  // de PhotoAiTag (subject, hasWatermark, isProfessionalStock, note), null si pas
  // encore analysé ou si ANTHROPIC_API_KEY absent. Jamais affiché à l'acheteur —
  // aide à la décision du modérateur, signal anti-fraude complémentaire au SHA-256.
  aiTags    String?
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([sha256])
}

// --- Lot 56 — Alertes de recherche sauvegardée (§27/§33 du cahier
// d'architecture, jamais construites jusqu'ici) : contrairement au rappel
// d'expiration (Lot 48), pas de balayage paresseux ici — le déclencheur est
// un vrai événement métier (une annonce devient PUBLIEE via la modération),
// pas le simple écoulement du temps, donc pas besoin de simuler un
// planificateur absent. `filters` stocke le même format que les paramètres de
// /recherche (validés par searchParamsSchema au moment de la comparaison),
// jamais interprété autrement qu'en le repassant par buildListingWhere — une
// seule source de vérité pour "qu'est-ce qui correspond à cette recherche",
// partagée avec la page de recherche elle-même.
model SearchAlert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  filters   String
  createdAt DateTime @default(now())
  notifications SearchAlertNotification[]

  @@index([userId])
}

// Empêche une même annonce de redéclencher un email pour la même alerte
// (ex: annonce suspendue puis ré-approuvée) — cf. index unique.
model SearchAlertNotification {
  id        String      @id @default(cuid())
  alertId   String
  alert     SearchAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sentAt    DateTime    @default(now())

  @@unique([alertId, listingId])
  @@index([listingId])
}

// --- Lot 170 — Faire une offre ---
// L'acheteur propose un montant au vendeur. Le vendeur accepte ou refuse.
// Une seule offre PENDING par (listing, acheteur) à la fois.

enum OfferStatus {
  PENDING   // en attente de réponse du vendeur
  ACCEPTED  // acceptée par le vendeur
  DECLINED  // refusée par le vendeur (vendeur) ou par l'acheteur (contre-offre)
  WITHDRAWN // retirée par l'acheteur
  COUNTERED // contre-offre proposée par le vendeur, en attente de l'acheteur
}

model Offer {
  id            String      @id @default(cuid())
  listingId     String
  listing       Listing     @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         User        @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId      String
  seller        User        @relation("SellerOffers", fields: [sellerId], references: [id], onDelete: Cascade)
  amount        Int
  message       String?     @db.VarChar(500)
  status        OfferStatus @default(PENDING)
  counterAmount Int?        // renseigné uniquement quand status = COUNTERED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
}

// --- Lot 76 — Blog « SOUQ AUTO MAG » (docs/ARCHITECTURE.md §37 : « Pages
// marque/modèle/wilaya, blog « SOUQ AUTO MAG », données structurées
// schema.org » ; §2 : /mag, /mag/{slug-article}), dernière page de contenu
// SEO documentée mais jamais construite. Contenu bilingue en base (mêmes
// conventions que Wilaya/Equipment), les deux langues requises à la
// publication — jamais un article à moitié traduit visible publiquement.
// Pas de champ image de couverture pour l'instant : aucune source de photo
// fiable/libre de droits disponible sur cette machine (même limite que le
// jeu de données de démonstration, Lot 71) ; texte seul.
model BlogArticle {
  id          String    @id @default(cuid())
  slug        String    @unique
  titleFr     String
  titleAr     String
  excerptFr   String
  excerptAr   String
  contentFr   String
  contentAr   String
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  // Lot 110 — un essai auto est un article enrichi (RoadTest, 1-1) : même
  // stockage, même administration, même publication programmée. `publishedAt`
  // dans le futur = programmé (visible seulement une fois la date atteinte).
  kind        ArticleKind @default(ARTICLE)
  roadTest    RoadTest?
  guide       BuyingGuide?
  previewLinks ArticlePreviewLink[]
  // Lot 111 — photo de couverture (essais), toujours un fichier de notre propre
  // stockage « blog-covers » (jamais une URL externe, cf. src/lib/blog-cover.ts).
  coverImageUrl String?
  // Lot 115 — source d'un article du magazine rédigé à partir d'un document
  // externe (typiquement un dossier de presse de constructeur) : nom affiché et
  // lien facultatif. Jamais pour un essai, qui décrit un véhicule testé par la
  // rédaction. L'adresse est normalisée (src/lib/press-review.ts).
  sourceName    String?
  sourceUrl     String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
  @@index([kind, publishedAt])
}

enum ArticleKind {
  ARTICLE
  ESSAI
  GUIDE
  EQUIPEMENT
}

// Lot 110 — fiche d'un essai auto. Seulement des données réellement saisies par
// la rédaction : aucune consommation/prix « mesuré » inventé. Note sur 5 par
// demi-point ; points forts/faibles stockés comme String, un élément par ligne.
// Ce format convient tant que ces champs sont seulement affichés (split("\n")).
// Si une requête filtrante devient nécessaire (WHERE prosFr LIKE …), migrer
// vers une table associative RoadTestPoint { kind, locale, text }.
model RoadTest {
  articleId     String      @id
  article       BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  brandId       Int?
  brand         Brand?      @relation(fields: [brandId], references: [id])
  modelId       Int?
  model         Model?      @relation(fields: [modelId], references: [id])
  generationId  Int?
  generation    Generation? @relation(fields: [generationId], references: [id])
  rating        Float
  prosFr        String
  prosAr        String
  consFr        String
  consAr        String
  verdictFr     String
  verdictAr     String
  testedVersion String?
  testedAt      DateTime?

  @@index([brandId])
  @@index([modelId])
}

// Lot 126 — guide d'achat PAR MODÈLE : un article de fond (texte Markdown, comme un essai) rattaché à un
// modèle du catalogue, avec deux éléments structurés — une liste « à vérifier avant d'acheter » (une
// ligne par point, 1 à 12) et « notre conseil ». Le contenu est rédigé par l'équipe : le site ne fournit
// aucun texte de départ. Le modèle est obligatoire (c'est ce qui relie le guide à sa page modèle et aux
// annonces de ce modèle) ; la marque se déduit du modèle ; la génération est facultative.
model BuyingGuide {
  articleId    String      @id
  article      BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  // Lot 144 — un guide peut être GÉNÉRAL (aucun modèle : « acheter une voiture d'occasion ») : marque, modèle et génération sont
  // alors tous nuls. Une contrainte SQL (BuyingGuide_scope_check, non modélisable ici) garantit la cohérence : un modèle porte toujours
  // sa marque, et une génération n'existe jamais sans modèle. `Restrict` explicite : sans lui, une relation facultative se défait
  // silencieusement (SET NULL) à la suppression d'un modèle, ce qui transformerait un guide de modèle en guide général.
  brandId      Int?
  brand        Brand?      @relation(fields: [brandId], references: [id], onDelete: Restrict)
  modelId      Int?
  model        Model?      @relation(fields: [modelId], references: [id], onDelete: Restrict)
  generationId Int?
  generation   Generation? @relation(fields: [generationId], references: [id])
  checklistFr  String
  checklistAr  String
  adviceFr     String
  adviceAr     String

  @@index([modelId])
  @@index([brandId])
}

// Lot 114 — revue de presse : un LIEN vers un essai publié par un autre média,
// jamais son texte. Ne sont stockés que des faits (média, titre tel que publié,
// adresse, date de parution chez lui) et la phrase que la rédaction écrit
// elle-même dans chaque langue. `url` est unique (adresse normalisée, cf.
// src/lib/press-review.ts) : le même article ne figure qu'une fois.
// `publishedAt` : null = brouillon, date passée = en ligne (comme BlogArticle).
model PressReview {
  id                String    @id @default(cuid())
  sourceName        String
  url               String    @unique
  title             String
  sourcePublishedAt DateTime?
  noteFr            String
  noteAr            String
  brandId           Int?
  brand             Brand?    @relation(fields: [brandId], references: [id], onDelete: SetNull)
  modelId           Int?
  model             Model?    @relation(fields: [modelId], references: [id], onDelete: SetNull)
  publishedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([publishedAt])
  @@index([modelId, publishedAt])
}

// Lot 116 — avis d'un propriétaire sur un modèle du catalogue.
//
// Avis de « propriétaire DÉCLARÉ » : aucune preuve de possession n'est demandée,
// et l'affichage le dit. Publié seulement après validation par l'équipe
// (`EN_ATTENTE` → `PUBLIE` ou `REFUSE`). Un auteur modifie ou retire son avis ;
// toute modification le remet en attente (on ne publie pas un texte, puis on le
// remplace par un autre sans relecture). Un seul avis par personne et par modèle.
enum OwnerReviewStatus {
  EN_ATTENTE
  PUBLIE
  REFUSE
}

model OwnerReview {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  modelId         Int
  model           Model             @relation(fields: [modelId], references: [id], onDelete: Cascade)
  rating          Int
  comment         String
  purchaseYear    Int?
  mileageKm       Int?
  status          OwnerReviewStatus @default(EN_ATTENTE)
  // Motif communiqué à l'auteur (refus, ou retrait après signalement confirmé).
  rejectionReason String?
  moderatedAt     DateTime?
  publishedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reports         Report[]

  @@unique([userId, modelId])
  @@index([modelId, status])
  @@index([status, createdAt])
}

// Lot 119 — contact rapide depuis une annonce (appel, WhatsApp). Le numéro n'est
// plus envoyé avec la page : il est demandé au serveur au moment du clic, ce qui
// permet de limiter le débit et de compter les contacts (statistiques pour les
// professionnels). Seuls l'annonce, le canal, l'éventuel utilisateur connecté et
// la date sont conservés — jamais l'adresse IP ni le numéro.
enum ContactChannel {
  TELEPHONE
  WHATSAPP
}

model ContactEvent {
  id        String         @id @default(cuid())
  listingId String
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  channel   ContactChannel
  userId    String?
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([listingId, createdAt])
}

// Lot 122 — vues d'une annonce PAR JOUR, pour les statistiques des professionnels. `Listing.views`
// ne garde que le total : impossible d'en tirer une évolution. Compteur agrégé seulement — ni adresse
// IP, ni identifiant de visiteur, ni date de visite précise : on ne sait pas QUI a vu, seulement
// combien de fois par jour. `day` est la date civile en Algérie (UTC+1, sans heure d'été). Incrémenté
// en une seule requête atomique (voir src/lib/view-tracking.ts). Les vues d'avant ce lot n'ont pas de détail.
model ListingViewDay {
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  day       DateTime @db.Date
  count     Int      @default(0)

  @@id([listingId, day])
}

// Lot 123 — suivi des prospects d'un compte professionnel : le statut de la relation et une note
// PRIVÉE, attachés à une conversation (un prospect = une personne identifiée qui a écrit au vendeur à
// propos d'une annonce). Aucune donnée nouvelle sur l'acheteur n'est stockée ni exposée : seuls le
// statut et la note saisis par l'équipe du vendeur. Sans ligne, le prospect est « NOUVEAU » (la ligne
// n'est créée qu'à la première modification). Supprimée avec la conversation.
enum ProspectStatus {
  NOUVEAU
  A_RAPPELER
  EN_NEGOCIATION
  GAGNE
  PERDU
}

model ProspectFollowUp {
  conversationId String         @id
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         ProspectStatus @default(NOUVEAU)
  note           String?
  updatedAt      DateTime       @updatedAt
  // Qui a modifié en dernier (le propriétaire ou un collaborateur) ; effacé si le compte disparaît.
  updatedById    String?
  updatedBy      User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)
}

// Lot 124 — mesure d'audience du site, SANS cookie et SANS identifiant. Une ligne = un nombre de pages
// vues pour un jour civil algérien, une page (modèle d'adresse, jamais l'adresse réelle), une langue,
// un type d'appareil et une catégorie de provenance. On ne stocke ni adresse IP, ni User-Agent, ni
// paramètres d'adresse, ni identifiant de visiteur ou de session : il est impossible de savoir QUI a
// vu QUOI, ni de suivre une personne d'une page ou d'un jour à l'autre. Les colonnes texte valent ""
// plutôt que NULL pour faire partie de la clé primaire. Conservé 25 mois au plus (voir src/lib/analytics-record.ts).
model PageViewDay {
  day      DateTime @db.Date
  // Modèle d'adresse sans la langue : "/recherche", "/annonce/[id]", "/mag/[slug]"…
  page     String
  // Pour les pages de contenu seulement (article, essai, marque, modèle, wilaya) : l'identifiant public
  // dans l'adresse, vérifié comme existant avant d'être gardé. "" sinon.
  detail   String   @default("")
  locale   String
  // "mobile" | "tablette" | "ordinateur"
  device   String
  // "direct" | "interne" | "recherche" | "reseaux" | "autre" — jamais le site de provenance lui-même.
  referrer String
  count    Int      @default(0)

  @@id([day, page, detail, locale, device, referrer])
}

// Lot 121 — abonnement aux notifications sur UN appareil (navigateur ou application installée).
// `endpoint` désigne le service de notification du navigateur (Google, Mozilla, Apple, Microsoft) ;
// `p256dh` et `auth` sont les clés publiques qui permettent de chiffrer chaque message pour cet
// appareil seulement. Un appareil = une ligne (`endpoint` unique) : si un autre compte se connecte
// sur le même appareil, la ligne change de propriétaire. Supprimée dès que le service de
// notification répond que l'appareil n'existe plus (404 ou 410).
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSentAt DateTime?

  @@index([userId])
}

// Lot 160 — demande de rappel téléphonique d'un visiteur vers un vendeur professionnel.
// Aucun compte n'est requis : le visiteur laisse son nom, son numéro et un créneau préféré.
// Le professionnel lit et traite les demandes depuis son tableau de bord prospects.
enum CallbackPreferredTime {
  MATIN
  APRES_MIDI
  SOIR
  PEU_IMPORTE
}

enum CallbackStatus {
  NOUVEAU
  RAPPELE
  ANNULE
}

model CallbackRequest {
  id            String                @id @default(cuid())
  proAccountId  String
  proAccount    ProfessionalAccount   @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  listingId     String?
  listing       Listing?              @relation(fields: [listingId], references: [id], onDelete: SetNull)
  callerName    String
  callerPhone   String
  preferredTime CallbackPreferredTime @default(PEU_IMPORTE)
  status        CallbackStatus        @default(NOUVEAU)
  note          String?
  createdAt     DateTime              @default(now())

  @@index([proAccountId, createdAt])
  @@index([listingId])
}

// Lot 161 — abonnement d'un acheteur à un compte professionnel.
// Quand le pro publie une nouvelle annonce (modération approuvée), chaque abonné
// reçoit une notification push sur ses appareils enregistrés.
model ProFollow {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  proAccountId String
  proAccount   ProfessionalAccount @relation(fields: [proAccountId], references: [id], onDelete: Cascade)
  createdAt    DateTime            @default(now())

  @@unique([userId, proAccountId])
  @@index([proAccountId])
  @@index([userId])
}

// Lot 132 — connexion avec un compte Google (OpenID Connect). Une ligne = un compte Google (identifiant `sub`, stable
// et propre à Google) lié à un compte du site. On ne garde volontairement RIEN d'autre venant de Google : ni adresse,
// ni nom, ni photo. Supprimée avec le compte (cascade) et à la suppression du compte par son titulaire, sans quoi
// l'identifiant Google rouvrirait un compte anonymisé.
model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Lot 133 — lien « mot de passe oublié ». On ne garde JAMAIS le jeton lui-même, seulement son empreinte SHA-256 : une
// copie de la base ne donne alors aucun lien utilisable. Un seul lien valable à la fois par compte (une nouvelle demande
// supprime les précédents), à usage unique, valable une heure.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Lot 138 — codes de secours de la double authentification : dix codes à usage unique, à utiliser si le téléphone est perdu.
// On ne garde que leur empreinte HMAC (clé dérivée de ENCRYPTION_KEY) : une copie de la base ne donne aucun code utilisable,
// et un code de 60 bits ne peut pas être retrouvé par force brute hors ligne sans la clé du serveur.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([userId, codeHash])
  @@index([userId])
}

// Lot 241 — notification in-app persistante, complémentaire de l'email et du push.
// Jamais un doublon de l'email : c'est l'historique consultable depuis l'application,
// que le push soit activé ou non, que l'email soit arrivé ou non.
// TTL 30 jours : le sweeper nightly supprime les entrées plus anciennes.
enum NotificationKind {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_SUSPENDED
  OFFER_RECEIVED
  OFFER_ACCEPTED
  OFFER_DECLINED
  OFFER_COUNTERED
  SEARCH_ALERT_MATCH
  PRO_FOLLOWER_LISTING
}

model UserNotification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  // Données contextuelles (titre de l'annonce, montant de l'offre, etc.) et URL
  // de destination. Stocker l'URL ici évite de la recalculer à l'affichage et
  // permet de l'utiliser dans le badge même si l'objet cible a été supprimé.
  data      Json
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
}

// Lot 146 — lien d'APERÇU d'un contenu non publié, pour un relecteur qui n'a pas de compte administrateur (un juriste, un locuteur
// natif). Le jeton n'est JAMAIS stocké en clair : seule son empreinte (HMAC avec la clé du serveur) l'est, comme les codes de secours de
// la double authentification — une copie de la base ne permet pas de forger un lien. Lié à UN contenu, à durée limitée, révocable.
model ArticlePreviewLink {
  id          String      @id @default(cuid())
  articleId   String
  article     BlogArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tokenHash   String      @unique
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([articleId])
}

// Lot 243 — historique de connexion. TTL 90 jours (sweeper nightly).
// userId nullable : les tentatives sur un compte inexistant ne sont PAS enregistrées
// (évite l'énumération d'adresses via la table). Seules les tentatives sur un compte
// trouvé (succès ou échec de mot de passe) sont conservées.
model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String
  userAgent String
  method    String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// --- Lot 252 — Messagerie de groupe ---

model GroupConversation {
  id          String         @id @default(cuid())
  name        String
  createdById String
  createdBy   User           @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  messages    GroupMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([createdById])
}

model GroupMember {
  groupId    String
  group      GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id])
  isAdmin    Boolean           @default(false)
  joinedAt   DateTime          @default(now())
  // Dernier moment où ce membre a ouvert la conversation — sert à calculer
  // les messages non lus sans table de jonction supplémentaire.
  lastReadAt DateTime?

  @@id([groupId, userId])
  @@index([userId])
}

model GroupMessage {
  id            String            @id @default(cuid())
  groupId       String
  group         GroupConversation @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User              @relation(fields: [senderId], references: [id])
  content       String
  attachmentUrl String?
  audioUrl      String?
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())

  @@index([groupId])
  @@index([groupId, createdAt])
}
