# Base de données — PostgreSQL partout (dev, tests, production ; cf. README.md pour la création
# du rôle et des bases). En production, ajouter des paramètres de pool à l'URL, par exemple
#   ?connection_limit=10&pool_timeout=20
# (dimensionner selon le nombre d'instances × max_connections du serveur ; derrière PgBouncer,
# ajouter &pgbouncer=true). Créer la base avec une collation FR/Unicode, pas la collation « C ».
DATABASE_URL="postgresql://souq_auto:change-me@localhost:5432/souq_auto"

# Base des tests de bout en bout Playwright (`npm run test:e2e`) : VIDÉE ENTIÈREMENT à chaque
# exécution. Le nom de la base doit finir par « _e2e » (sinon le script refuse de la vider) et
# elle doit être différente de DATABASE_URL.
E2E_DATABASE_URL="postgresql://souq_auto:change-me@localhost:5432/souq_auto_e2e"

# Secret JWT — générer une valeur aléatoire forte en production (ex: openssl rand -base64 48)
JWT_SECRET="change-me-in-production"

# URL publique du site — utilisée pour les URLs canoniques, Open Graph, JSON-LD et le sitemap.
# À remplacer par le domaine réel en production.
NEXT_PUBLIC_SITE_URL="http://localhost:5184"

# Chiffrement au repos (téléphone utilisateur, documents de vérification d'identité —
# cf. docs/ARCHITECTURE.md §47). Clé AES-256 encodée en base64 (32 octets), ex :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Limite de bootstrap assumée : cette clé reste en clair dans .env, comme JWT_SECRET
# ci-dessus — aucun coffre-fort externe (Vault/KMS) n'est en place à ce jour. Protège
# contre l'exfiltration du fichier de base de données ou d'une sauvegarde, pas contre
# une compromission du serveur applicatif lui-même (qui a accès à .env).
ENCRYPTION_KEY="change-me-in-production"

# Suggestion de titre/description à la publication (étape 7, "AI Listing").
# Optionnelle : sans clé, un repli heuristique déterministe (gabarit à partir
# des caractéristiques déjà saisies) est utilisé à la place — jamais désactivé,
# jamais une fabrication IA simulée. Définir cette variable active l'appel réel
# à l'API Anthropic (https://console.anthropic.com/) sans changer le reste du code.
# ANTHROPIC_API_KEY="sk-ant-..."

# Rate limiting (src/lib/rate-limit.ts) et messagerie temps réel
# (src/lib/realtime.ts) — cf. docs/ARCHITECTURE.md §6. Optionnelle : sans
# REDIS_URL, un repli en mémoire mono-instance est utilisé à la place (comme
# avant ce lot) — jamais un blocage de l'application. Définir cette variable
# active le partage réel entre plusieurs instances du serveur, sans changer
# le reste du code. Exemple local : redis://127.0.0.1:6379
# REDIS_URL="redis://127.0.0.1:6379"

# Stockage des photos (annonces, avatars, pièces jointes de messagerie —
# cf. src/lib/uploads.ts, src/lib/storage.ts, docs/ARCHITECTURE.md §6).
# Optionnelle : sans S3_BUCKET, les photos restent écrites sur le disque
# local du serveur comme avant ce lot — jamais un blocage de l'application.
# Nécessaire dès que l'app tourne sur plusieurs instances (le disque local
# n'est pas partagé entre elles). S3_PUBLIC_URL est l'URL de base réellement
# utilisée par les navigateurs (peut différer de S3_ENDPOINT, qui sert
# uniquement aux appels serveur→API S3 — S3_PUBLIC_URL peut être un CDN/
# domaine personnalisé en production). Le bucket doit être configuré en
# lecture publique côté fournisseur — pas possible de façon portable depuis
# le code applicatif. Exemple local (MinIO) :
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_PUBLIC_URL="http://127.0.0.1:9000/souq-auto-photos"
# S3_BUCKET="souq-auto-photos"
# S3_ACCESS_KEY_ID="minioadmin"
# S3_SECRET_ACCESS_KEY="minioadmin"
# S3_REGION="us-east-1"

# --- Mise en production (Lot 117) — vérifier avec : npm run launch:check -------------------

# Envoi d'emails (vérification d'adresse, décisions de modération, notifications).
# OBLIGATOIRE en production : sans SMTP_HOST, l'application refuse d'envoyer (en développement,
# un compte de test Ethereal est utilisé à la place). Voir src/lib/mail-config.ts.
# SMTP_HOST="smtp.exemple.org"
# SMTP_PORT="587"            # 465 = TLS implicite ; SMTP_SECURE="true"/"false" force le choix
# SMTP_USER="utilisateur"
# SMTP_PASS="mot-de-passe"
# SMTP_FROM="Souq Auto <contact@votre-domaine.dz>"   # domaine à vous, avec SPF et DKIM configurés

# Nombre de serveurs intermédiaires DE CONFIANCE (nginx, répartiteur de charge, CDN) placés devant
# l'application : 1 pour un seul, 2 pour un CDN puis nginx. Sert à retrouver la vraie adresse IP des
# visiteurs pour les limites de débit. Sans cette variable, l'en-tête X-Forwarded-For est pris tel
# quel et se falsifie : toutes les limites par IP se contournent. Voir src/lib/client-ip.ts.
# TRUSTED_PROXY_HOPS="1"

# Adresses de l'équipe de modération, séparées par des virgules : elles reçoivent un courriel quand
# une annonce, un avis de propriétaire, une demande d'identité ou un signalement attend une décision
# (au plus un par type et par 30 minutes, avec l'état de toute la file). Sans cette variable, aucune
# alerte : la file n'est vue qu'en ouvrant le back-office. Voir src/lib/staff-alerts.ts.
# STAFF_ALERT_EMAILS="moderation@votre-domaine.dz, gestion@votre-domaine.dz"

# Compte administrateur créé par `npm run db:seed`. En production, les deux sont OBLIGATOIRES
# (mot de passe d'au moins 12 caractères, différent de celui du README) : le compte de
# développement admin@souqauto.dz n'est alors pas créé. Voir src/lib/admin-bootstrap.ts.
# ADMIN_EMAIL="gestion@votre-domaine.dz"
# ADMIN_PASSWORD="un-mot-de-passe-long-et-unique"

# Notifications push (Lot 121) : recevoir les alertes de recherche directement sur le téléphone ou
# l'ordinateur, site fermé. Sans ces trois variables, la fonction est simplement désactivée (les alertes
# restent envoyées par email). Générer la paire UNE FOIS avec : npm run push:keys (local) ou
# npm run push:keys -- --print (à copier dans le gestionnaire de secrets du serveur).
# Ne jamais regénérer une paire en production sans nécessité : tous les appareils abonnés devraient
# réactiver les notifications. La clé privée est un secret, comme JWT_SECRET. Voir src/lib/push.ts.
# VAPID_PUBLIC_KEY="..."     # 87 caractères, transmise aux navigateurs
# VAPID_PRIVATE_KEY="..."    # 43 caractères, SECRÈTE
# VAPID_SUBJECT="mailto:contact@votre-domaine.dz"   # contact du site, transmis aux services de notification
